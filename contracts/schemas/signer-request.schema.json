{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vc/signer-request.schema.json",
  "title": "Body of POST /reactors/{id}/react (becomes event.req)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "intent_mac"
  ],
  "properties": {
    "intent": {
      "$ref": "intent.schema.json"
    },
    "intent_mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}