{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vc/intent.schema.json",
  "title": "vc-intent-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "audience",
    "order_id",
    "attempt_id",
    "chain_id",
    "asset",
    "from",
    "to",
    "value",
    "valid_after",
    "valid_before",
    "nonce",
    "policy_version",
    "issued_at"
  ],
  "properties": {
    "v": {
      "const": "vc-intent-1"
    },
    "audience": {
      "const": "vc-signer"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "chain_id": {
      "const": "84532"
    },
    "asset": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "from": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "to": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "value": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "valid_after": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "valid_before": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    }
  }
}