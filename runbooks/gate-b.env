# Gate B public constants. No secrets here: addresses and ids only.
# Change a value here and every terminal picks it up with: source runbooks/gate-b.env
# Secrets stay out: INTENT_HMAC_KEY in ~/.config/vaulted-checkout/spend.env, BT keys via read -s.

# Basis Theory (test tenant)
export BT_API_BASE=https://api.test.basistheory.com
export SIGNER_ID=b548cf32-34d3-4a02-9201-17f9b78b59fb          # vc-signer Reactor (payee below)
export BT_SIGNER_REACTOR_ID=$SIGNER_ID                          # same value, name the spend service reads
export WALLET_TOKEN_ID=d474d0c3-7c3c-40dd-aec9-98ed68e8c5f3     # vaulted wallet key token (id only)

# Chain: Base Sepolia
export WALLET_ADDRESS=0x1feD0f4EF284900B88966A05D0a8F5F6C39F0229   # vaulted wallet (payer)
export MERCHANT_PAYTO=0xc17a7A2A339a071D84B129AB0812a72c3A7cd758   # merchant payee, must match the Reactor allowlist
export USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e     # Base Sepolia USDC
export CHAIN_ID=84532

# Local services
export MERCHANT_ORIGIN=http://127.0.0.1:4000
export SPEND_URL=http://127.0.0.1:4001

# Retired, do not use: 607b75c0-03b6-4282-bfe8-b0745c5c7346 (pays public test address; delete in portal)
